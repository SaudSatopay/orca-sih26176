# ORCA environment. Copy to .env and export, or set these in your host's dashboard.
# Every variable is optional: with none set, ORCA runs the full pipeline on demo data.
# The backend reads them from the process environment (backend/app/config.py).

# DEMO (default) serves cached, labelled scenario data; LIVE calls public marine/weather APIs and falls back to demo data on failure.
ORCA_DATA_MODE=DEMO

# Seconds before a live API call is abandoned in favour of cached demo data (default 4.0).
ORCA_LIVE_TIMEOUT=4.0

# Optional. Enables the LLM rephrasing layer; it never computes a risk score. Leave empty to run rule-based.
ANTHROPIC_API_KEY=

# Model used when ANTHROPIC_API_KEY is set (default shown).
ORCA_LLM_MODEL=claude-sonnet-5

# Set to 0 to keep the LLM layer off even when a key is present (default 1).
ORCA_USE_LLM=1
